# Lumen + Firefox VPN Core — example environment variables
# Copy to .env and fill in real values. NEVER commit real secrets.
# On Railway, supply these as service environment variables instead of a .env file.

# Public HTTP port (Railway sets $PORT automatically)
PORT=8080

# Lumen admin panel password
ADMIN_PASSWORD=CHANGE_ME

# Firefox VPN account (admin-only; supplied via Railway variables, never in image)
FIREFOX_VPN_EMAIL=admin@example.com
FIREFOX_VPN_PASSWORD=CHANGE_ME
FIREFOX_VPN_LOCATION=DE

# Telegram (optional)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_ADMIN_IDS=123456789
TELEGRAM_DEFAULT_EXIT=DE
TELEGRAM_DIAL_ADDRESS=tg.example.com

# Persistent storage
DATA_DIR=/data
LUMEN_REQUIRE_PERSISTENT_STORAGE=1
# RAILWAY_VOLUME_MOUNT_PATH is set by Railway when a volume is mounted at /data
